# Local development (docker-compose ile gelen Postgres)
DATABASE_URL="postgresql://sablon:sablon_dev_password@localhost:5432/mobilya?schema=public"

# Auth.js (NextAuth) session signing secret — `openssl rand -base64 32` ile üret
AUTH_SECRET=""

# İlk admin kullanıcısı (seed script bunu okuyup AdminUser tablosuna ekler)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# --- Production (Vercel + Supabase) ---
# Bu değerler Vercel'e girilir, ayrıntılar DEPLOYMENT.md'de.
# DATABASE_URL: Supabase > Connect > "Session pooler" adresi
#   postgresql://postgres.[PROJE]:[ŞİFRE]@aws-0-[BÖLGE].pooler.supabase.com:5432/postgres
# NEXT_PUBLIC_SUPABASE_URL="https://[PROJE].supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# ^ İkisi tanımlıysa panelden yüklenen görseller Supabase Storage'a gider
#   (tanımlı değilse yerelde public/uploads klasörüne yazılır).

# --- E-posta (Resend, opsiyonel) ---
# Şifremi unuttum, şifre değiştirme onay kodu, kullanıcı daveti ve yeni
# talep bildirimi için. Tanımlı değilse bu e-postalar gönderilmez; talep
# formu yine çalışır (ayrıntılar DEPLOYMENT.md'de).
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="Örnek Mobilya <noreply@ornekmobilya.com>"
# ADMIN_NOTIFY_EMAIL="info@ornekmobilya.com"

# --- Otomatik çeviri (Google Gemini, opsiyonel) ---
# Paneldeki "Türkçeden çevir" ve "Eksik Çeviriler" için. aistudio.google.com
# → Get API key. Tanımlı değilse bu düğmeler kapalı kalır.
# GEMINI_API_KEY=""
# GEMINI_MODELS="gemini-flash-latest,gemini-3.6-flash,gemini-flash-lite-latest"

# --- Site adresi (sitemap / canonical / hreflang için) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
